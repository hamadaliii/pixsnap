# PixSnap Backend Environment Variables
# Copy this to .env and fill in your values

SUPABASE_URL=https://fylmsluzxqctjsjxkszt.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=eu-west-1

STRIPE_SECRET=sk_test_...

FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration (replaces Resend)
# For Gmail: enable 2FA and use an App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=PixSnap <your_email@gmail.com>
