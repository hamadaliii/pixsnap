# PixSnap Backend Environment Variables
# Copy this to .env and fill in your values

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── AWS Rekognition ───────────────────────────────────────────────────
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=eu-west-1

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET=sk_test_...

# ── Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── SMTP Email ────────────────────────────────────────────────────────
# For Gmail: enable 2FA and use an App Password
# https://myaccount.google.com/apppasswords
# If SMTP_USER / SMTP_PASSWORD are empty the app shows "Email not configured"
# instead of pretending mail was sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=PixSnap <your_email@gmail.com>

# ── Phase 1 (optional) ────────────────────────────────────────────────
# Salt used to hash guest IPs before storing them (privacy). If unset a
# static default is used; set a random value in production.
IP_HASH_SALT=change-me-to-a-random-string

# ── Phase 3 (optional, all failsafe if unset) ─────────────────────────
# Cloudflare Turnstile secret for bot protection on expensive guest flows.
TURNSTILE_SECRET=
# Sentry DSN for backend error tracking.
SENTRY_DSN=

# ── Object Storage (optional — Supabase is the default & fallback) ────
# Move thumbnails/previews/ZIPs off Supabase to cut egress. If R2/S3 vars
# are missing, the app transparently keeps using Supabase Storage.
STORAGE_PROVIDER=supabase          # supabase | r2 | s3

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                          # legacy single-bucket (still supported)
R2_PUBLIC_BUCKET=                   # thumbnails + watermarked previews (safe to expose)
R2_PRIVATE_BUCKET=                  # originals, selfies, zips, temp (signed URLs only)
R2_PUBLIC_BASE_URL=                 # e.g. https://cdn.pixsnap.se  (watermarked assets only)
R2_ENDPOINT=                        # optional; defaults to https://<account>.r2.cloudflarestorage.com

# AWS S3
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BUCKET=
AWS_S3_PRIVATE_BUCKET=
AWS_S3_REGION=eu-west-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=             # optional CloudFront/base URL for public assets
